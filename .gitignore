# Secrets — the Fantasy Footballers login lives here. Never commit.
config.json

# Python venv used by the one-time xlsx extraction
.venv/

# macOS
.DS_Store

# Local design-hook consent (machine-specific)
.impeccable/config.local.json
.impeccable/hook.cache.json

# One-save-back copy the plan editor leaves behind
data/*.json.bak

# The draft board IS committed — data/board.<season>.json is the record of the
# draft, the same way data/board.local.json holds 2025. Nothing to ignore here.

# Build-time screenshots
.impeccable/shots/
.impeccable/questions/

# Saved thefantasyfootballers.com session cookies. Never commit.
.auth/

# pid + log file for the background server started by Start Draft.command
.run/

# Raw source pulls kept for diffing; regenerate with npm run refresh
data/raw/

# The 2025 source workbooks. Migration is done (tools/extract_from_xlsx.py
# pulled everything into data/), and one of them has live Google Sheets URLs
# inside it. They stay on disk, out of the repo.
*.xlsx
