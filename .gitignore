# Secrets — the Google API key lives here. Never commit.
config.json

# Python venv used by the one-time xlsx extraction
.venv/

# macOS
.DS_Store

# Local design-hook consent (machine-specific)
.impeccable/config.local.json
.impeccable/hook.cache.json

# Generated board tab (regenerate with tools/make-board-tab.mjs)
out/

# One-save-back copy the plan editor leaves behind
data/*.json.bak

# Mock-draft scratch board, written by the in-app pick box. Regenerates itself;
# the real fixture is data/board.local.json and that one IS committed.
data/board.mock.json

# Build-time screenshots
.impeccable/shots/
.impeccable/questions/

# Saved thefantasyfootballers.com session cookies. Never commit.
.auth/

# Raw source pulls kept for diffing; regenerate with npm run refresh
data/raw/
